# Copy these public provider settings into the dev deployment's existing .env.
# Read issuer and jwks_uri from Authentik's OpenID configuration document.
WATCH_OIDC_ISSUER=https://authentik.richardbignell.co.uk/application/o/footyapp-watch-dev/
WATCH_OIDC_CLIENT_ID=pE0A0W-YKb5vXUGHgpEbFpcrFjWH6wWk
WATCH_OIDC_JWKS_URL=https://authentik.richardbignell.co.uk/application/o/footyapp-watch-dev/jwks/

# Used by the manual login-and-pull test, not by Flask.
WATCH_PULL_URL=https://footyappdev.richardbignell.co.uk/watch/score-json

# Push is dev-only and requires a persistent journal (compose supplies its path).
WATCH_PUSH_ENABLED=false
WATCH_PUSH_JOURNAL=/app/watch-data/submissions.sqlite3
